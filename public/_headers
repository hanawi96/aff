# Cloudflare Pages headers
# Dữ liệu địa chỉ hành chính 2025.
# tree_2.json dùng no-cache: trình duyệt LUÔN validate ETag với server trước khi dùng
# cache → khi file đổi nội dung (cập nhật phường/xã) người dùng nhận bản mới NGAY,
# còn nếu không đổi thì server trả 304 rất nhẹ (không tải lại 600KB).
/assets/data/tree_2.json
  Cache-Control: no-cache

/assets/data/tree.json
  Cache-Control: public, max-age=2592000

/assets/data/ward_mapping_2025.json
  Cache-Control: public, max-age=2592000

# Admin mobile PWA
/admin/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/admin/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/admin/icons/*
  Cache-Control: public, max-age=604800
